# Makefile.in for mod_markdown_agent
# Generated by configure from Makefile.in

APXS        = @APXS@
APACHECTL   = @APACHECTL@
LIBXML2_INC = @LIBXML2_INC@
LIBXML2_LIBS = @LIBXML2_LIBS@

SRCS        = mod_markdown_agent.c html2md.c

PACKAGE  = @PACKAGE_NAME@
VERSION  = @PACKAGE_VERSION@
DISTNAME = $(PACKAGE)-$(VERSION)

.PHONY: all install clean distclean reload regression test dist

all:
	$(APXS) -c \
		-Wc,-Wall \
		-Wc,-I$(LIBXML2_INC) \
		-Wl,$(LIBXML2_LIBS) \
		$(SRCS)

install: all
	$(APXS) -i -a -n markdown_agent mod_markdown_agent.la
	@echo ""
	@echo "Module installed. Add to httpd.conf if not already present:"
	@echo "  LoadModule markdown_agent_module modules/mod_markdown_agent.so"
	@echo ""
	@echo "Then: $(APACHECTL) configtest && $(APACHECTL) graceful"

clean:
	rm -f *.o *.lo *.la *.so *.slo
	rm -rf .libs

distclean: clean
	rm -f Makefile config.log config.status
	rm -rf autom4te.cache

dist:
	rm -rf $(DISTNAME)
	mkdir $(DISTNAME)
	cp mod_markdown_agent.c html2md.c html2md.h $(DISTNAME)/
	cp configure.ac Makefile.in $(DISTNAME)/
	cp configure $(DISTNAME)/
	cp install-sh $(DISTNAME)/ 2>/dev/null || true
	cp example.conf README.md LICENSE $(DISTNAME)/
	tar czf $(DISTNAME).tar.gz $(DISTNAME)
	rm -rf $(DISTNAME)
	@echo "Created $(DISTNAME).tar.gz"

reload:
	$(APACHECTL) graceful

# -----------------------------------------------------------------------
# Quick smoke test: curl with Accept: text/markdown against localhost
# Usage: make test URL=http://localhost/some-page.html
# -----------------------------------------------------------------------
test:
	@echo "--- Response headers ---"
	curl -sI -H "Accept: text/markdown" "$(URL)"
	@echo ""
	@echo "--- Response body (first 40 lines) ---"
	curl -s  -H "Accept: text/markdown" "$(URL)" | head -40

# -----------------------------------------------------------------------
# Regression tests: compare live output against known-good expected files
# Usage: make regression BASE_URL=https://scooby.netsville.com
# Requires test HTML files deployed to the docroot.
# -----------------------------------------------------------------------
BASE_URL = https://scooby.netsville.com
TESTDIR  = testfiles

regression:
	@pass=0; fail=0; \
	for html in $(TESTDIR)/*.html; do \
		name=$$(basename $$html .html); \
		expected="$(TESTDIR)/$$name.expected"; \
		if [ ! -f "$$expected" ]; then \
			echo "SKIP $$name (no .expected file)"; \
			continue; \
		fi; \
		tmp=$$(mktemp); \
		curl -s -H "Accept: text/markdown" "$(BASE_URL)/$$name.html" > "$$tmp"; \
		if diff -u "$$expected" "$$tmp" > /dev/null 2>&1; then \
			echo "PASS $$name"; \
			pass=$$((pass + 1)); \
		else \
			echo "FAIL $$name"; \
			diff -u "$$expected" "$$tmp"; \
			fail=$$((fail + 1)); \
		fi; \
		rm -f "$$tmp"; \
	done; \
	echo ""; \
	echo "$$pass passed, $$fail failed"; \
	[ $$fail -eq 0 ]
